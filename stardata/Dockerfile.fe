# =============================================================================
# Stardata FE — Apache Doris branch-4.2 with snap_id auto-injection patch
#               + Snowflake JDBC catalog support patch
#
# Build strategy (no full Maven build required):
#   Stage 1 (builder): compile only the patched .java files against the
#                       classpath already present in doris-fe.jar, then replace
#                       the original .class files in the JAR.
#   Stage 2 (runtime): copy the patched JAR into a clean copy of the base image.
#
# Patches applied:
#   CreateTableInfo.java    — injectSnapIdColumn() prepends snap_id BIGINT NOT NULL
#                             AUTO_INCREMENT to every new internal OLAP table.
#   JdbcResource.java       — adds JDBC_SNOWFLAKE / SNOWFLAKE constants and a
#                             parseDbType() branch for jdbc:snowflake:// URLs.
#   JdbcClient.java         — adds a SNOWFLAKE case in createJdbcClient() that
#                             returns a new JdbcSnowflakeClient instance.
#   JdbcSnowflakeClient.java — new client: minimal Snowflake type mapping on top
#                              of the JdbcClient base class.
# =============================================================================

# ── Stage 1: compile patches and replace class files in doris-fe.jar ─────────
# Pin to the exact Doris version tested with Snowflake JDBC patches.
# To upgrade: change this tag, rebuild, verify javac succeeds, re-roll pods.
# Tested version: doris-4.1.4.1 (Docker Hub tag: fe-4.1.4.1)
FROM docker.io/apache/doris:fe-4.1.4.1 AS builder

# Copy all patched source files
COPY doris-patch/CreateTableInfo.java \
     /patch/src/org/apache/doris/nereids/trees/plans/commands/info/CreateTableInfo.java

COPY doris-patch/JdbcResource.java \
     /patch/src/org/apache/doris/catalog/JdbcResource.java

COPY doris-patch/JdbcClient.java \
     /patch/src/org/apache/doris/datasource/jdbc/client/JdbcClient.java

COPY doris-patch/JdbcSnowflakeClient.java \
     /patch/src/org/apache/doris/datasource/jdbc/client/JdbcSnowflakeClient.java

COPY doris-patch/JdbcMongoDBClient.java \
     /patch/src/org/apache/doris/datasource/jdbc/client/JdbcMongoDBClient.java

COPY doris-patch/JdbcTable.java \
     /patch/src/org/apache/doris/catalog/JdbcTable.java

# Build classpath from all JARs in the FE lib directory; compile all patched files
RUN CP=$(find /opt/apache-doris/fe/lib -name '*.jar' | tr '\n' ':') && \
    mkdir -p /patch/classes && \
    javac \
      --release 17 \
      -encoding UTF-8 \
      -cp "${CP}" \
      -d /patch/classes \
      /patch/src/org/apache/doris/nereids/trees/plans/commands/info/CreateTableInfo.java \
      /patch/src/org/apache/doris/catalog/JdbcResource.java \
      /patch/src/org/apache/doris/catalog/JdbcTable.java \
      /patch/src/org/apache/doris/datasource/jdbc/client/JdbcClient.java \
      /patch/src/org/apache/doris/datasource/jdbc/client/JdbcSnowflakeClient.java \
      /patch/src/org/apache/doris/datasource/jdbc/client/JdbcMongoDBClient.java

# Patch doris-fe.jar: replace all changed classes and inner classes
RUN cp /opt/apache-doris/fe/lib/doris-fe.jar /patch/doris-fe.jar && \
    cd /patch/classes && \
    jar uf /patch/doris-fe.jar \
      org/apache/doris/nereids/trees/plans/commands/info/CreateTableInfo.class \
      $(find org/apache/doris/nereids/trees/plans/commands/info -name 'CreateTableInfo$*.class' 2>/dev/null) \
      org/apache/doris/catalog/JdbcResource.class \
      $(find org/apache/doris/catalog -name 'JdbcResource$*.class' 2>/dev/null) \
      org/apache/doris/catalog/JdbcTable.class \
      $(find org/apache/doris/catalog -name 'JdbcTable$*.class' 2>/dev/null) \
      org/apache/doris/datasource/jdbc/client/JdbcClient.class \
      $(find org/apache/doris/datasource/jdbc/client -name 'JdbcClient$*.class' 2>/dev/null) \
      org/apache/doris/datasource/jdbc/client/JdbcSnowflakeClient.class \
      $(find org/apache/doris/datasource/jdbc/client -name 'JdbcSnowflakeClient$*.class' 2>/dev/null) \
      org/apache/doris/datasource/jdbc/client/JdbcMongoDBClient.class \
      $(find org/apache/doris/datasource/jdbc/client -name 'JdbcMongoDBClient$*.class' 2>/dev/null)

# ── Stage 2: final image with patched JAR ────────────────────────────────────
FROM docker.io/apache/doris:fe-4.1.4.1

LABEL org.stardata.version="4.4"
LABEL org.stardata.base="apache/doris:branch-4.2"
LABEL org.stardata.patch="snap_id-auto-inject,snowflake-jdbc,mongodb-jdbc"

COPY --from=builder /patch/doris-fe.jar /opt/apache-doris/fe/lib/doris-fe.jar

# ── Bake JDBC drivers into image so the httpd sidecar can serve them ─────────
# The seed-jdbc-drivers initContainer copies these into the shared emptyDir.
COPY jars/snowflake-jdbc-4.0.2.jar   /opt/apache-doris/fe/jdbc_drivers/snowflake-jdbc-4.0.2.jar
COPY jars/ojdbc11.jar                 /opt/apache-doris/fe/jdbc_drivers/ojdbc11.jar
COPY jars/postgresql-42.7.4.jar       /opt/apache-doris/fe/jdbc_drivers/postgresql-42.7.4.jar
COPY jars/mongodb-jdbc-2.0.2-all.jar  /opt/apache-doris/fe/jdbc_drivers/mongodb-jdbc-2.0.2-all.jar
