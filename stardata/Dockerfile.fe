# =============================================================================
# Stardata FE — Apache Doris branch-4.2 with Stardata feature patches
#               + Snowflake JDBC catalog support patch
#               + Databricks JDBC catalog support patch
#
# Build strategy (no full Maven build required):
#   Stage 1 (builder): compile only the patched .java files against the
#                       classpath already present in doris-fe.jar, then replace
#                       the original .class files in the JAR.
#   Stage 2 (runtime): copy the patched JAR into a clean copy of the base image.
#
# Patches applied (CreateTableInfo.java — injectStardataFeatures()):
#   (a) injectSnapIdColumnIfIceberg()  — injects snap_id BIGINT NOT NULL AUTO_INCREMENT
#                                        only when PROPERTIES ("stardata.table_type"="iceberg").
#   (b) injectCreatedAtColumn()        — appends created_at DATETIMEV2 NOT NULL
#                                        DEFAULT CURRENT_TIMESTAMP when missing (all tables).
#       injectUpdatedAtColumnIfIceberg()— appends updated_at DATETIMEV2 NOT NULL
#                                        DEFAULT CURRENT_TIMESTAMP ON UPDATE … (iceberg only).
#       cache_system excluded for regular tables only; iceberg-type tables allowed through.
#   (d) injectAutoRangePartition()     — AUTO PARTITION BY RANGE (date_trunc('day', created_at))
#                                        + HASH(snap_id) for iceberg / RANDOM for regular (no unique key)
#                                        / existing dist for unique-key tables.
#                                        Opt-out: PROPERTIES ("stardata.disable_partition"="true")
#   (c) injectStoragePolicy()          — sets "storage_policy"="sd_cold_1d" (hot→cold
#                                        after 1 day). Applied to all qualifying tables.
#                                        Never overwrites a user-supplied value.
#
#   JdbcResource.java         — adds JDBC_SNOWFLAKE/SNOWFLAKE and JDBC_DATABRICKS/DATABRICKS
#                               constants and parseDbType() branches.
#   JdbcClient.java           — adds SNOWFLAKE and DATABRICKS cases in createJdbcClient().
#   JdbcSnowflakeClient.java  — Snowflake type mapping on top of JdbcClient base class.
#   JdbcDatabricksClient.java — Databricks/Spark SQL type mapping on top of JdbcClient
#                               base class. PAT auth: user=token, password=<PAT>.
# =============================================================================

# ── Stage 1: compile patches and replace class files in doris-fe.jar ─────────
# Pin to the exact Doris version tested with Snowflake JDBC patches.
# To upgrade: change this tag, rebuild, verify javac succeeds, re-roll pods.
# Tested version: doris-4.1.4.1 (Docker Hub tag: fe-4.1.4.1)
FROM docker.io/apache/doris:fe-4.1.4.1 AS builder

# Copy all patched source files
COPY doris-patch/CreateTableInfo.java \
     /patch/src/org/apache/doris/nereids/trees/plans/commands/info/CreateTableInfo.java

COPY doris-patch/JdbcResource.java \
     /patch/src/org/apache/doris/catalog/JdbcResource.java

COPY doris-patch/JdbcClient.java \
     /patch/src/org/apache/doris/datasource/jdbc/client/JdbcClient.java

COPY doris-patch/JdbcSnowflakeClient.java \
     /patch/src/org/apache/doris/datasource/jdbc/client/JdbcSnowflakeClient.java

COPY doris-patch/JdbcMongoDBClient.java \
     /patch/src/org/apache/doris/datasource/jdbc/client/JdbcMongoDBClient.java

COPY doris-patch/JdbcDatabricksClient.java \
     /patch/src/org/apache/doris/datasource/jdbc/client/JdbcDatabricksClient.java

COPY doris-patch/JdbcTable.java \
     /patch/src/org/apache/doris/catalog/JdbcTable.java

# Build classpath from all JARs in the FE lib directory; compile all patched files
RUN CP=$(find /opt/apache-doris/fe/lib -name '*.jar' | tr '\n' ':') && \
    mkdir -p /patch/classes && \
    javac \
      --release 17 \
      -encoding UTF-8 \
      -cp "${CP}" \
      -d /patch/classes \
      /patch/src/org/apache/doris/nereids/trees/plans/commands/info/CreateTableInfo.java \
      /patch/src/org/apache/doris/catalog/JdbcResource.java \
      /patch/src/org/apache/doris/catalog/JdbcTable.java \
      /patch/src/org/apache/doris/datasource/jdbc/client/JdbcClient.java \
      /patch/src/org/apache/doris/datasource/jdbc/client/JdbcSnowflakeClient.java \
      /patch/src/org/apache/doris/datasource/jdbc/client/JdbcMongoDBClient.java \
      /patch/src/org/apache/doris/datasource/jdbc/client/JdbcDatabricksClient.java

# Patch doris-fe.jar: replace all changed classes and inner classes.
# Use find -print0 | xargs to safely handle the case where no inner classes exist.
RUN cp /opt/apache-doris/fe/lib/doris-fe.jar /patch/doris-fe.jar && \
    cd /patch/classes && \
    find . -name '*.class' -print0 | xargs -0 jar uf /patch/doris-fe.jar

# ── Stage 2: final image with patched JAR ────────────────────────────────────
FROM docker.io/apache/doris:fe-4.1.4.1

LABEL org.stardata.version="4.6.2"
LABEL org.stardata.base="apache/doris:branch-4.2"
LABEL org.stardata.patch="snap_id-iceberg-only,created_at-auto-inject,updated_at-iceberg-only,auto-range-partition,iceberg-hash-snap_id,regular-unique-hash-dist,sd_cold_1d-storage-policy-non-mow,cooldown-sidecar,snowflake-jdbc,mongodb-jdbc,databricks-jdbc"

COPY --from=builder /patch/doris-fe.jar /opt/apache-doris/fe/lib/doris-fe.jar

# ── Cooldown policy sidecar script ───────────────────────────────────────────
# Baked into the FE image so the ddl-mirror sidecar container can run it
# using the python:3.12-alpine image already present in the pod.
COPY doris-patch/cooldown_policy.py /opt/apache-doris/fe/bin/cooldown_policy.py

# ── Bake JDBC drivers into image so the httpd sidecar can serve them ─────────
# The seed-jdbc-drivers initContainer copies these into the shared emptyDir.
COPY jars/snowflake-jdbc-4.0.2.jar              /opt/apache-doris/fe/jdbc_drivers/snowflake-jdbc-4.0.2.jar
COPY jars/ojdbc11.jar                            /opt/apache-doris/fe/jdbc_drivers/ojdbc11.jar
COPY jars/postgresql-42.7.4.jar                  /opt/apache-doris/fe/jdbc_drivers/postgresql-42.7.4.jar
COPY jars/mongodb-jdbc-2.0.2-all.jar             /opt/apache-doris/fe/jdbc_drivers/mongodb-jdbc-2.0.2-all.jar
COPY jars/databricks-jdbc-2.6.36.1070.jar        /opt/apache-doris/fe/jdbc_drivers/databricks-jdbc-2.6.36.1070.jar
