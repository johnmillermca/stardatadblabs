# =============================================================================
# Dockerfile — DuckDB latest + iceberg + httpfs extensions
# Image tag : 192.168.1.50:30500/duckdb:latest
# Base      : python:3.12-slim  (installs DuckDB CLI + python wrapper)
# Server    : duckdb-http-server (lightweight REST bridge for SQL-over-HTTP)
# =============================================================================
FROM python:3.12-slim

# ── System dependencies ──────────────────────────────────────────────────────
RUN apt-get update && apt-get install -y --no-install-recommends \
        curl \
        ca-certificates \
        unzip \
    && rm -rf /var/lib/apt/lists/*

# ── Install latest DuckDB CLI binary ────────────────────────────────────────
# v2.0.0+ ships as .tar.gz (previously .zip).
RUN DUCKDB_VERSION=$(curl -sL https://api.github.com/repos/duckdb/duckdb/releases/latest \
        | python3 -c "import json,sys; print(json.load(sys.stdin)['tag_name'])") \
    && echo "Installing DuckDB ${DUCKDB_VERSION}" \
    && curl -sL "https://github.com/duckdb/duckdb/releases/download/${DUCKDB_VERSION}/duckdb-cli-linux-amd64.tar.gz" \
        -o /tmp/duckdb_cli.tar.gz \
    && tar -xzf /tmp/duckdb_cli.tar.gz -C /usr/local/bin/ \
    && chmod +x /usr/local/bin/duckdb \
    && rm /tmp/duckdb_cli.tar.gz

# ── Python DuckDB SDK + HTTP server ─────────────────────────────────────────
RUN pip install --no-cache-dir \
        duckdb \
        fastapi \
        uvicorn[standard] \
        boto3

# ── Pre-install DuckDB extensions into the image layer ──────────────────────
# Extensions land in /root/.duckdb/extensions — cached in the container layer
# so pods never pull from the internet at runtime.
RUN duckdb -c "INSTALL iceberg; INSTALL httpfs; INSTALL aws;"

# ── Copy entrypoint + HTTP server ───────────────────────────────────────────
COPY duckdb_server.py /app/duckdb_server.py
COPY entrypoint.sh    /entrypoint.sh
RUN chmod +x /entrypoint.sh

WORKDIR /app
EXPOSE 8580

ENTRYPOINT ["/entrypoint.sh"]
