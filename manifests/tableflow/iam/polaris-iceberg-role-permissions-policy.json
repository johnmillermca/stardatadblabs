{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "IcebergObjectAccess",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject",
        "s3:AbortMultipartUpload",
        "s3:ListMultipartUploadParts"
      ],
      "Resource": [
        "arn:aws:s3:::xdatatoiceberg1/*",
        "arn:aws:s3:::stardata-databricks/*"
      ]
    },
    {
      "Sid": "IcebergBucketList",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket",
        "s3:GetBucketLocation"
      ],
      "Resource": [
        "arn:aws:s3:::xdatatoiceberg1",
        "arn:aws:s3:::stardata-databricks"
      ]
    }
  ]
}
